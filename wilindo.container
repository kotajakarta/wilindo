[Unit]
Description=Wilindo Wilayah API (Rootless)
After=network-online.target

[Container]
# Base image Node.js — kode sudah di-build lebih dulu oleh dep.sh (lihat langkah "Build Aplikasi"),
# container ini hanya menjalankan hasil build tersebut.
Image=docker.io/library/node:24-alpine
WorkingDir=/app

# Nama container — dipakai reverse proxy/cloudflared untuk routing wilindo.aithendi.my.id ke sini
ContainerName=wilindo

# Menghubungkan container langsung ke jaringan Podman 'global_net'
Network=global_net

# Mount kode aplikasi (hasil build) sebagai READ-ONLY (:ro,Z) untuk keamanan
Volume=/webku/appsku/wilindo:/app:ro,Z

# Menjalankan server monolitik (API + static frontend React hasil build) dari hasil kompilasi TypeScript
Exec=node server/dist/index.js

# Berisi DATABASE_URL dan API_KEY (lihat instruksi-api.md)
EnvironmentFile=/webku/appsku/wilindo/.env

# === SEKSI HEALTH CHECK ===
HealthCmd=node -e "require('http').get('http://localhost:3076/api/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1));"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s

[Install]
WantedBy=default.target
